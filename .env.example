# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — never commit real secrets.

# Gmail account used by the contact form (Nodemailer / SMTP).
# EMAIL_PASSWORD must be a Google "App Password", not your account password.
EMAIL_USERNAME=your-address@gmail.com
EMAIL_PASSWORD=your-16-char-app-password

# Google Tag Manager / Analytics container ID (e.g. GTM-XXXXXXX). Optional.
NEXT_PUBLIC_ANALYTICS_ID=

# Public base URL of the deployed site (no trailing slash).
# Local: http://localhost:3000  •  Prod: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
